{%- comment -%}
  Featured collection — product slider.

  Runs on the same slider engine as sections/collection-deals-slider.liquid:
  assets/section-collection-deals-slider.css + .js, `cl-deals` namespace. One
  engine, one set of slider settings, one bundle for both sections — so don't
  rename those classes here without updating that JS.

  Slides hold Dawn product cards, so the deals slider's Card / Badge settings
  don't apply. Card looks (image ratio, radius, badge, colours) come from
  Theme settings > Product cards and > Badges, which keeps every product card
  on the site identical.
{%- endcomment -%}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-collection-deals-slider.css' | asset_url | stylesheet_tag }}
{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-collection-deals-slider.js' | asset_url }}" defer="defer"></script>

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign s = section.settings

  assign products_to_display = s.collection.all_products_count
  if s.collection.all_products_count > s.products_to_show
    assign products_to_display = s.products_to_show
    assign more_in_collection = true
  endif

  assign per_d = s.cards_desktop | default: 4
  assign per_t = s.cards_tablet | default: 3
  assign per_m = s.cards_mobile | default: 2.2

  assign pad_top_mobile = s.padding_top | times: 0.75 | round: 0
  assign pad_bottom_mobile = s.padding_bottom | times: 0.75 | round: 0

  comment
    Only the cards visible on first paint load eagerly — everything past the
    first desktop view is below the fold or off-screen in the track.
  endcomment
  assign eager_count = per_d | ceil

  assign show_nav = false
  if s.show_arrows and products_to_display > 1
    assign show_nav = true
  endif

  assign show_head = false
  if s.title != blank or show_nav
    assign show_head = true
  endif

  assign slider_label = 'general.slider.name' | t
  if s.title != blank
    assign slider_label = s.title | strip_html
  endif
  assign slider_label = slider_label | escape
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .cl-deals {
    --cl-pt-d: {{ s.padding_top }}px;
    --cl-pb-d: {{ s.padding_bottom }}px;
    --cl-pt-m: {{ pad_top_mobile }}px;
    --cl-pb-m: {{ pad_bottom_mobile }}px;

    --cl-maxw: {% if s.container_width == 'wide' %}140rem{% elsif s.container_width == 'full' %}100%{% else %}var(--page-width){% endif %};

    --cl-per-d: {{ per_d }};
    --cl-per-t: {{ per_t }};
    --cl-per-m: {{ per_m }};

    --cl-gap-d: {{ s.gap }}px;
    --cl-gap-m: {{ s.gap_mobile }}px;
  }
{%- endstyle -%}

<cl-deals-slider
  class="cl-deals cl-deals--products color-{{ s.color_scheme }} gradient{% if s.full_bleed %} cl-deals--bleed{% endif %}{% if s.show_arrows_mobile %} cl-deals--arrows-mobile{% endif %}"
  data-scroll-step="{{ s.scroll_step }}"
  data-slide-duration="{{ s.slide_duration | default: 600 }}"
>
  {%- if show_head -%}
    <div class="cl-deals__inner cl-deals__header">
      <div class="cl-deals__header-text">
        {%- if s.title != blank -%}
          <{{ s.heading_tag }} class="cl-deals__heading inline-richtext {{ s.heading_size }}">
            {{- s.title -}}
          </{{ s.heading_tag }}>
        {%- endif -%}

        {%- if s.show_description and s.collection.description != empty -%}
          <div class="cl-deals__description {{ s.description_style }} rte">{{ s.collection.description }}</div>
        {%- elsif s.description != blank -%}
          <div class="cl-deals__description {{ s.description_style }} rte">{{ s.description }}</div>
        {%- endif -%}
      </div>

      <div class="cl-deals__header-actions">
        {%- if s.show_view_all and s.view_all_style == 'link' and more_in_collection -%}
          <a
            class="cl-deals__viewall"
            href="{{ s.collection.url }}"
            aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: s.collection.title | escape }}"
          >
            {{- 'sections.featured_collection.view_all' | t -}}
          </a>
        {%- endif -%}

        {%- if show_nav -%}
          <div class="cl-deals__nav">
            <button
              type="button"
              class="cl-deals__arrow cl-deals__arrow--prev"
              name="previous"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
              aria-controls="Slider-{{ section.id }}"
            >
              <svg class="cl-deals__arrow-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M15 5L8 12l7 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button
              type="button"
              class="cl-deals__arrow cl-deals__arrow--next"
              name="next"
              aria-label="{{ 'general.slider.next_slide' | t }}"
              aria-controls="Slider-{{ section.id }}"
            >
              <svg class="cl-deals__arrow-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <ul
    id="Slider-{{ section.id }}"
    data-id="{{ section.id }}"
    class="cl-deals__track contains-card contains-card--product{% if settings.card_style == 'standard' %} contains-card--standard{% endif %}"
    role="list"
    tabindex="0"
    aria-label="{{ slider_label }}"
  >
    {%- if s.collection.products.size > 0 -%}
      {%- assign skip_card_product_styles = false -%}
      {%- for product in s.collection.products limit: s.products_to_show -%}
        {%- liquid
          assign lazy_load = true
          if forloop.index <= eager_count
            assign lazy_load = false
          endif
        -%}
        <li id="Slide-{{ section.id }}-{{ forloop.index }}" class="cl-deals__slide">
          {% render 'card-product',
            card_product: product,
            lazy_load: lazy_load,
            show_secondary_image: s.show_secondary_image,
            show_vendor: s.show_vendor,
            show_rating: s.show_rating,
            skip_styles: skip_card_product_styles,
            section_id: section.id,
            quick_add: s.quick_add,
            product_view_context: 'collection'
          %}
        </li>
        {%- assign skip_card_product_styles = true -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        {%- liquid
          assign ridx = forloop.rindex
          case ridx
            when 5
              assign ridx = 1
            when 6
              assign ridx = 2
          endcase
          assign placeholder_image = 'product-apparel-' | append: ridx
        -%}
        <li class="cl-deals__slide">
          {% render 'card-product',
            show_vendor: s.show_vendor,
            lazy_load: false,
            placeholder_image: placeholder_image
          %}
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>

  {%- if s.show_progress and products_to_display > 1 -%}
    <div class="cl-deals__inner">
      <div class="cl-deals__progress" aria-hidden="true">
        <span class="cl-deals__progress-thumb"></span>
      </div>
    </div>
  {%- endif -%}

  {%- if s.show_view_all and s.view_all_style != 'link' and more_in_collection -%}
    <div class="cl-deals__inner cl-deals__viewall-wrap">
      <a
        href="{{ s.collection.url }}"
        class="button{% if s.view_all_style == 'outline' %} button--secondary{% endif %}"
        aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: s.collection.title | escape }}"
      >
        {{ 'sections.featured_collection.view_all' | t }}
      </a>
    </div>
  {%- endif -%}
</cl-deals-slider>

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 25,
      "step": 1,
      "default": 8,
      "label": "t:sections.featured-collection.settings.products_to_show.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header_text.content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.featured-collection.settings.title.default",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML tag",
      "info": "Use H1 only if this section is the page's main heading.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.featured-collection.settings.description.label"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.featured-collection.settings.show_description.label",
      "default": false
    },
    {
      "type": "select",
      "id": "description_style",
      "label": "t:sections.featured-collection.settings.description_style.label",
      "options": [
        {
          "value": "body",
          "label": "t:sections.featured-collection.settings.description_style.options__1.label"
        },
        {
          "value": "subtitle",
          "label": "t:sections.featured-collection.settings.description_style.options__2.label"
        },
        {
          "value": "uppercase",
          "label": "t:sections.featured-collection.settings.description_style.options__3.label"
        }
      ],
      "default": "body"
    },
    { "type": "header", "content": "Slider" },
    {
      "type": "range",
      "id": "cards_desktop",
      "min": 2,
      "max": 6,
      "step": 0.1,
      "default": 4,
      "label": "Cards per view — desktop",
      "info": "A whole number fills the container exactly. Use a fraction (e.g. 4.4) to reveal part of the next card instead."
    },
    {
      "type": "range",
      "id": "cards_tablet",
      "min": 1.5,
      "max": 4,
      "step": 0.1,
      "default": 3,
      "label": "Cards per view — tablet"
    },
    {
      "type": "range",
      "id": "cards_mobile",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "default": 2.2,
      "label": "Cards per view — mobile",
      "info": "2.2 shows two cards plus a peek of the third."
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 18,
      "label": "Space between cards — desktop"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 10,
      "label": "Space between cards — mobile"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "page", "label": "Page width" },
        { "value": "wide", "label": "Wide (1400px)" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "page"
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "Let cards bleed to the screen edge",
      "info": "Off keeps every card inside the container, aligned with the rest of the page.",
      "default": false
    },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    {
      "type": "checkbox",
      "id": "show_arrows_mobile",
      "label": "Show arrows on mobile",
      "default": false
    },
    { "type": "checkbox", "id": "show_progress", "label": "Show progress bar", "default": true },
    {
      "type": "range",
      "id": "slide_duration",
      "min": 200,
      "max": 1400,
      "step": 50,
      "unit": "ms",
      "default": 600,
      "label": "Slide animation speed",
      "info": "How long the track takes to glide to the next card. Higher is slower and softer."
    },
    {
      "type": "select",
      "id": "scroll_step",
      "label": "Arrows advance by",
      "options": [
        { "value": "1", "label": "One card" },
        { "value": "page", "label": "One full view" }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header_collection.content"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.featured-collection.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.featured-collection.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "t:sections.featured-collection.settings.show_rating.label",
      "info": "t:sections.featured-collection.settings.show_rating.info"
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "none",
      "label": "t:sections.main-collection-product-grid.settings.quick_add.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_1"
        },
        {
          "value": "standard",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_2"
        },
        {
          "value": "bulk",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_3"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "t:sections.featured-collection.settings.show_view_all.label",
      "info": "t:sections.featured-collection.settings.show_view_all.info"
    },
    {
      "type": "select",
      "id": "view_all_style",
      "label": "t:sections.featured-collection.settings.view_all_style.label",
      "info": "“Link” moves it up beside the arrows.",
      "options": [
        {
          "value": "link",
          "label": "t:sections.featured-collection.settings.view_all_style.options__1.label"
        },
        {
          "value": "outline",
          "label": "t:sections.featured-collection.settings.view_all_style.options__2.label"
        },
        {
          "value": "solid",
          "label": "t:sections.featured-collection.settings.view_all_style.options__3.label"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-collection.presets.name"
    }
  ]
}
{% endschema %}
