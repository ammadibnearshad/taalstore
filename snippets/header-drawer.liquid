{% comment %}
  Renders a header drawer menu for mobile and desktop.

  Usage:
  {% render 'header-drawer' %}
{% endcomment %}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation">
            {%- if section.settings.enable_drawer_search -%}
              {%- render 'menu-drawer-search' -%}
            {%- endif -%}
            {%- liquid
              comment
                Same `mega_menu` / `mega_menu_card` blocks the desktop panel uses,
                matched to a menu item by title handle. A card-row menu surfaces
                here as a second-level panel even when the link has no sub-links.
              endcomment
              assign drawer_mega_blocks = section.blocks | where: 'type', 'mega_menu'
              assign drawer_card_blocks = section.blocks | where: 'type', 'mega_menu_card'
              assign menu_badges = section.settings.menu_badges | newline_to_br | split: '<br />'
            -%}
            <ul class="menu-drawer__menu has-submenu list-menu" role="list">
              {%- for link in section.settings.menu.links -%}
                {%- liquid
                  assign drawer_link_handle = link.title | downcase | handle

                  assign drawer_mega_block = nil
                  for candidate in drawer_mega_blocks
                    assign candidate_handle = candidate.settings.menu_title | downcase | handle
                    if candidate_handle == drawer_link_handle
                      assign drawer_mega_block = candidate
                      break
                    endif
                  endfor

                  assign drawer_card_ids = ''
                  if drawer_mega_block != nil
                    for card in drawer_card_blocks
                      assign card_handle = card.settings.menu_title | downcase | handle
                      if card_handle == drawer_link_handle
                        assign drawer_card_ids = drawer_card_ids | append: card.id | append: ','
                      endif
                    endfor
                  endif
                  assign drawer_card_ids = drawer_card_ids | split: ','

                  assign drawer_layout = ''
                  if drawer_mega_block != nil
                    assign drawer_layout = drawer_mega_block.settings.layout
                  endif

                  assign drawer_has_cards = false
                  assign drawer_has_columns = false
                  if drawer_layout == 'cards' and drawer_card_ids.size > 0
                    assign drawer_has_cards = true
                  elsif drawer_layout == 'columns'
                    if link.links != blank or drawer_card_ids.size > 0
                      assign drawer_has_columns = true
                    endif
                  endif

                  assign drawer_has_custom = false
                  if drawer_has_cards or drawer_has_columns
                    assign drawer_has_custom = true
                  endif
                -%}
                <li>
                  {%- if link.links != blank or drawer_has_custom -%}
                    <details id="Details-menu-drawer-menu-item-{{ forloop.index }}">
                      <summary
                        id="HeaderDrawer-{{ link.handle }}"
                        class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                      >
                        {{ link.title | escape }}
                        {%- render 'menu-badge', title: link.title, badges: menu_badges -%}
                        <span class="svg-wrapper">
                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                        </span>
                        <span class="svg-wrapper">
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </span>
                      </summary>
                      <div
                        id="link-{{ link.handle | escape }}"
                        class="menu-drawer__submenu has-submenu gradient motion-reduce"
                        tabindex="-1"
                      >
                        <div class="menu-drawer__inner-submenu">
                          <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                            <span class="svg-wrapper">
                              {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </span>
                            {{ link.title | escape }}
                          </button>

                          {%- if drawer_has_cards -%}
                            {%- render 'menu-drawer-cards',
                              link: link,
                              block: drawer_mega_block,
                              cards: drawer_card_blocks,
                              matched_ids: drawer_card_ids
                            -%}
                          {%- elsif drawer_has_columns -%}
                            {%- render 'menu-drawer-columns',
                              link: link,
                              block: drawer_mega_block,
                              cards: drawer_card_blocks,
                              matched_ids: drawer_card_ids
                            -%}
                          {%- endif -%}

                          {%- comment -%}
                            Both custom layouts replace the link list, same as on desktop.
                          {%- endcomment -%}
                          {%- if link.links != blank and drawer_has_custom == false -%}
                          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                            {%- for childlink in link.links -%}
                              <li>
                                {%- if childlink.links == blank -%}
                                  <a
                                    id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                    href="{{ childlink.url }}"
                                    class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                    {% if childlink.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {%- if section.settings.show_menu_collection_images -%}
                                      {%- render 'menu-collection-thumb', link: childlink -%}
                                    {%- endif -%}
                                    {{ childlink.title | escape }}
                                  </a>
                                {%- else -%}
                                  <details id="Details-menu-drawer-{{ link.handle }}-{{ childlink.handle }}">
                                    <summary
                                      id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                      class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                                    >
                                      {%- if section.settings.show_menu_collection_images -%}
                                        {%- render 'menu-collection-thumb', link: childlink -%}
                                      {%- endif -%}
                                      {{ childlink.title | escape }}
                                      <span class="svg-wrapper">
                                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                                      </span>
                                      <span class="svg-wrapper">
                                        {{- 'icon-caret.svg' | inline_asset_content -}}
                                      </span>
                                    </summary>
                                    <div
                                      id="childlink-{{ childlink.handle | escape }}"
                                      class="menu-drawer__submenu has-submenu gradient motion-reduce"
                                    >
                                      <button
                                        class="menu-drawer__close-button link link--text focus-inset"
                                        aria-expanded="true"
                                      >
                                        <span class="svg-wrapper">
                                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                                        </span>
                                        {{ childlink.title | escape }}
                                      </button>
                                      <ul
                                        class="menu-drawer__menu list-menu"
                                        role="list"
                                        tabindex="-1"
                                      >
                                        {%- for grandchildlink in childlink.links -%}
                                          <li>
                                            <a
                                              id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                              href="{{ grandchildlink.url }}"
                                              class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                              {% if grandchildlink.current %}
                                                aria-current="page"
                                              {% endif %}
                                            >
                                              {{ grandchildlink.title | escape }}
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  </details>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                          {%- endif -%}
                        </div>
                      </div>
                    </details>
                  {%- else -%}
                    <a
                      id="HeaderDrawer-{{ link.handle }}"
                      href="{{ link.url }}"
                      class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ link.title | escape }}
                      {%- render 'menu-badge', title: link.title, badges: menu_badges -%}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
          {%- render 'menu-drawer-footer' -%}
        </div>
      </div>
    </div>
  </details>
</header-drawer>
