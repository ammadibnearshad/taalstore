{%- comment -%}
  PDP fit note — small "runs small / true to size" line, from custom.fit_note metafield
  (falls back to the block's own text). Accepts: block, product.
{%- endcomment -%}

{{ 'component-pdp-blocks.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign note = product.metafields.custom.fit_note
  if note == blank
    assign note = block.settings.fallback_text
  endif
-%}
{%- if note != blank -%}
  <p class="pdp-fit-note" {{ block.shopify_attributes }}>
    <svg class="pdp-fit-note__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 5a1.2 1.2 0 110 2.4A1.2 1.2 0 0112 7zm1.5 10h-3v-1.2h.9v-3.6h-.9V11h2.1v4.8h.9V17z" fill="currentColor"/></svg>
    <span>{{ note }}</span>
  </p>
{%- endif -%}
