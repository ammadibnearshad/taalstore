{%- comment -%}
  Shared line-icon set. Accepts: icon (string, required).
  Used by sections/icon-benefits.liquid and sections/trust-bar.liquid —
  keep the select options in both schemas in sync with the cases below.
  Renders a decorative 24x24 stroke icon inheriting currentColor.
{%- endcomment -%}

<svg
  class="icon-benefits__svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'truck' -%}
      <path d="M2.5 5.5h10.5v10.5H2.5z" /><path d="M13 9h3.8l3.7 3.7V16H13z" /><path
        d="M8 16h5"
      /><circle cx="5.75" cy="18" r="2" /><circle cx="17.25" cy="18" r="2" />
    {%- when 'shield' -%}
      <path
        d="M12 2.5l7.5 3v6c0 4.6-3.1 8.4-7.5 9.9-4.4-1.5-7.5-5.3-7.5-9.9v-6z"
      /><path d="M8.75 11.9l2.25 2.25 4.25-4.4" />
    {%- when 'bolt' -%}
      <path d="M13.4 2.5 5 13.5h5.4L10.6 21.5 19 10.5h-5.4z" />
    {%- when 'return' -%}
      <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" />
    {%- when 'box' -%}
      <path
        d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"
      /><path d="m3.3 7 8.7 5 8.7-5" /><path d="M12 22V12" /><path d="m7.5 4.3 9 5.1" />
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9" /><path d="M12 7v5.2l3.4 2" />
    {%- when 'lock' -%}
      <rect x="3.5" y="10.5" width="17" height="10.5" rx="2" /><path
        d="M8 10.5V7a4 4 0 0 1 8 0v3.5"
      />
    {%- when 'card' -%}
      <rect x="2.5" y="5" width="19" height="14" rx="2" /><path d="M2.5 10h19" /><path
        d="M6 14.5h3.5"
      />
    {%- when 'cash' -%}
      <rect x="2" y="6" width="20" height="12" rx="2" /><circle cx="12" cy="12" r="2.5" /><path
        d="M5.5 9.5h.01M18.5 14.5h.01"
      />
    {%- when 'heart' -%}
      <path
        d="M19.5 5.5a5 5 0 0 0-7.5.6 5 5 0 0 0-7.5-.6 5.2 5.2 0 0 0 0 7.3l7.5 7.6 7.5-7.6a5.2 5.2 0 0 0 0-7.3Z"
      />
    {%- when 'star' -%}
      <path d="m12 2.5 2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5-4.8-4.6 6.6-.9z" />
    {%- when 'chat' -%}
      <path
        d="M20.5 11.5a8.5 8.5 0 0 1-8.5 8.5 8.4 8.4 0 0 1-3.8-.9L3.5 20.5l1.4-4.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 8.5-8.5h.5a8.5 8.5 0 0 1 8 8z"
      />
    {%- when 'tag' -%}
      <path
        d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0l-7.2-7.2A2 2 0 0 1 2.8 12V4.8a2 2 0 0 1 2-2H12a2 2 0 0 1 1.4.6l7.2 7.2a2 2 0 0 1 0 2.8Z"
      /><circle cx="7.6" cy="7.6" r="1.3" />
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path
        d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18Z"
      />
    {%- when 'leaf' -%}
      <path
        d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10Z"
      /><path d="M2.5 21c0-3 1.9-5.4 5.1-6C10 14.5 12.5 13 13.5 12" />
    {%- when 'sparkle' -%}
      <path d="M12 2.5 14 9l6.5 2-6.5 2-2 6.5-2-6.5L3.5 11 10 9z" /><path d="M19 3v3.5" /><path
        d="M17.25 4.75h3.5"
      />
    {%- else -%}
      <circle cx="12" cy="12" r="9" /><path d="m8.5 12 2.5 2.5 4.5-5" />
  {%- endcase -%}
</svg>
