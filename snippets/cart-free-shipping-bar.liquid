{%- comment -%}
  Free-shipping progress bar — Taal Store (ported to Dawn, Liquid-only).
  Recomputes on every drawer/cart re-render, so no JS is needed.
  Reads theme settings: free_shipping_enable, free_shipping_threshold (major units).
  Usage: {% render 'cart-free-shipping-bar' %}
{%- endcomment -%}

{%- liquid
  unless settings.free_shipping_enable
    break
  endunless
  assign threshold = settings.free_shipping_threshold | times: 100
  if threshold <= 0
    break
  endif
  assign remaining = threshold | minus: cart.total_price
  assign pct = cart.total_price | times: 100.0 | divided_by: threshold
  if pct > 100
    assign pct = 100
  endif
-%}
{%- if cart != empty -%}
  <div class="cart-free-ship{% if remaining <= 0 %} is--unlocked{% endif %}" role="status">
    <p class="cart-free-ship__msg">
      {%- if remaining <= 0 -%}
        🎉 {{ 'You’ve unlocked free shipping!' }}
      {%- else -%}
        {{ 'You’re' }} <strong>{{ remaining | money }}</strong> {{ 'away from free shipping' }}
      {%- endif -%}
    </p>
    <div class="cart-free-ship__track" aria-hidden="true">
      <span class="cart-free-ship__fill" style="width: {{ pct }}%;"></span>
    </div>
  </div>
{%- endif -%}
